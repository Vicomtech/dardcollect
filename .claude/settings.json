{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv:*)",
      "Bash(.venv/bin/python:*)",
      "Bash(.venv/Scripts/python.exe:*)",
      "Bash(python:*)",
      "Bash(ruff:*)",
      "Bash(ty:*)",
      "Bash(wc -l:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git check-ignore:*)"
    ],
    "deny": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ]
  }
}

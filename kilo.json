{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "@playwright/mcp"],
      "enabled": true,
      "timeout": 15000
    }
  },
  "permission": {
    "bash": {
      "uv *": "allow",
      "uv run *": "allow",
      "uv sync": "allow",
      "uv pip:*": "allow",
      ".venv/Scripts/python.exe *": "allow",
      ".venv/bin/python *": "allow",
      "python *": "allow",
      "python -m ruff:*": "allow",
      "python -m ty:*": "allow",
      "python -m pytest:*": "allow",
      "python -m pip:*": "allow",
      "ruff check *": "allow",
      "ruff format:*": "allow",
      "ruff --version": "allow",
      "ty check *": "allow",
      "wc -l *": "allow",
      "git status": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git stash *": "allow",
      "git checkout *": "allow",
      "git check-ignore *": "allow",
      "docker info *": "allow",
      "docker start *": "allow"
    },
    "webfetch": "allow"
  }
}